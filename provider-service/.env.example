# Google AI Studio (free tier). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional override -- defaults to gemini-3.6-flash (current as of 2026-07-28,
# released 2026-07-21). Re-verify at ai.google.dev/gemini-api/docs/pricing
# before assuming this is still current if revisiting this later.
GEMINI_MODEL=

# Cloudflare Workers AI (free tier: 10,000 Neurons/day, no card required).
# Account ID is in the Cloudflare dashboard URL; create an API token with the
# "Workers AI" template at https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional overrides -- default to the current catalog entries confirmed at
# developers.cloudflare.com/workers-ai/models/ on 2026-07-28.
CLOUDFLARE_IMAGE_MODEL=
CLOUDFLARE_AUDIO_MODEL=

# Pinata (free tier: 1GB storage, 500 files, no card required).
# Create a JWT at https://app.pinata.cloud/developers/api-keys
PINATA_JWT=

# Optional -- your dedicated Pinata gateway subdomain, e.g. "myproject" for
# https://myproject.mypinata.cloud. Defaults to the shared public gateway.
PINATA_GATEWAY_DOMAIN=
