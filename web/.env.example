# Studio deployment of the Provider Court escrow contract. Read server-side
# for on-chain reads/writes (autoFulfillOrder, get_job/get_order, etc).
# This is the current live deployment (equal-weighting payout fix +
# transaction-return-value id correlation) -- see contract/README.md for
# the full deployment history.
GENLAYER_CONTRACT_ADDRESS=0x8F92A82CE0E0474379A4aE0D0d696cD88884Db48

# Same address, exposed to the browser -- the client-side wallet-signed
# write path needs it directly, reads stay server-side via the var above.
# Must be set in Vercel's dashboard (any NEXT_PUBLIC_* var is baked into the
# client bundle at build time, so it has to be present when Vercel runs the
# build, not just at runtime).
NEXT_PUBLIC_GENLAYER_CONTRACT_ADDRESS=0x8F92A82CE0E0474379A4aE0D0d696cD88884Db48

# Which GenLayer network the wallet-connect flow targets. Currently the only
# real option this app is verified against.
NEXT_PUBLIC_GENLAYER_NETWORK=studionet

# Set to "true" to let the app fall back to the fixed demo accounts below
# when no wallet is connected. A real visitor always signs with their own
# connected wallet regardless of this flag -- it only affects what happens
# when nobody is connected. Defaults to "false" here so this template is
# safe to copy as-is for a public deployment: anonymous visitors are
# required to connect a real wallet instead of quietly spending the shared
# demo account's funds. For local dev, set this to "true" in your own
# .env.local (not this file) to click through without installing MetaMask.
# This flag alone only gates the frontend's CHOICE of signing path -- see
# ALLOW_DEMO_SIGNING below for the actual enforcement.
NEXT_PUBLIC_ALLOW_DEMO_SIGNING=false

# Server-side enforcement counterpart to the flag above. getBuyerClient()/
# getProviderClient() (lib/genlayer-server.ts) -- the functions every
# demo-signing API route actually uses to sign -- refuse to hand out a
# signer at all unless this is exactly "true", independent of anything the
# frontend sent. This is the real security boundary; the public flag above
# is only the UX-level choice on top of it. Defaults to "false" here so a
# deployment that copies this file as-is does NOT accidentally expose demo
# signing. For local dev, set this to "true" in your own .env.local (not
# this file) for convenience.
ALLOW_DEMO_SIGNING=false

# Dev-only fallback signers, used only when no wallet is connected AND both
# flags above are true. Never exposed to the browser (no NEXT_PUBLIC_
# prefix). These are real private keys controlling real accounts on Studio
# -- treat them as sensitive even though Studio's GEN has no real monetary
# value.
GENLAYER_BUYER_PRIVATE_KEY=
GENLAYER_PROVIDER_PRIVATE_KEY=

# The address this key controls must be passed as the contract's
# `fulfillment_operator` constructor arg at deploy time -- submit_delivery()
# and adjudicate() accept a signature from this address on ANY order,
# regardless of which real wallet's listing it came from. This is what
# makes automatic delivery/adjudication possible for a real third-party
# provider's order (see contract/README.md's auto-fulfill pipeline). Always
# required, regardless of NEXT_PUBLIC_ALLOW_DEMO_SIGNING -- every purchase
# depends on this, not just the demo path. Never exposed to the browser.
GENLAYER_FULFILLMENT_OPERATOR_PRIVATE_KEY=

# Generation (Gemini/Cloudflare Workers AI/Pinata) -- merged in from the
# former separately-deployed provider-service project, now runs in-process
# as part of this same app (lib/gemini.ts, lib/cloudflare.ts, lib/pinata.ts,
# lib/generate-content.ts). One project, one deployment -- no second
# PROVIDER_SERVICE_URL to keep in sync or accidentally leave misconfigured.
#
# Google AI Studio (free tier). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override -- defaults to gemini-3.6-flash (see lib/gemini.ts).
GEMINI_MODEL=

# Cloudflare Workers AI (free tier: 10,000 Neurons/day, no card required).
# Account ID is in the Cloudflare dashboard URL; create an API token with the
# "Workers AI" template at https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional overrides -- default to the current catalog entries (see
# lib/cloudflare.ts).
CLOUDFLARE_IMAGE_MODEL=
CLOUDFLARE_AUDIO_MODEL=

# Pinata (free tier: 1GB storage, 500 files, no card required).
# Create a JWT at https://app.pinata.cloud/developers/api-keys
PINATA_JWT=
# Strongly recommended -- your account's dedicated gateway FULL domain (e.g.
# "yourname.mypinata.cloud", copied exactly from Pinata's dashboard Gateways
# page). The code uses this value directly as the host
# (`https://${PINATA_GATEWAY_DOMAIN}/ipfs/...`), so it must be the complete
# domain, not just a subdomain prefix. Leaving this unset falls back to the
# shared public gateway.pinata.cloud, which is unreliable in practice --
# confirmed timing out ("ERR_ID:00016") on content that was genuinely pinned.
PINATA_GATEWAY_DOMAIN=

# Optional -- only used if you provision Vercel KV and link it to this
# project (Vercel injects these automatically once linked, no manual value
# needed here). When absent, lib/fulfill-progress.ts's stage-tracking falls
# back to an in-memory Map, which does not reliably survive across separate
# serverless function instances in a real deployment -- see that file's own
# comment for the tradeoff.
KV_REST_API_URL=
KV_REST_API_TOKEN=
